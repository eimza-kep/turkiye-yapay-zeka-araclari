# ==============================================================================
# TÜRKİYE YAPAY ZEKA ARAÇLARI - API YAPILANDIRMASI
# ==============================================================================
# Bu dosyayı '.env' olarak kaydedip dilediğiniz API anahtarını tanımlayabilirsiniz.
# 'python baslat.py' çalıştırarak da otomatik olarak ayarlayabilirsiniz.
# ==============================================================================

# 1. Google Gemini API Anahtarı (ÖNERİLEN - Hızlı ve Ücretsiz Kullanım):
# Ücretsiz almak için: https://aistudio.google.com/app/apikey (Kredi kartı gerekmez)
GEMINI_API_KEY=

# 2. OpenAI API Anahtarı (Alternatif):
# Almak için: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. Anthropic Claude API Anahtarı (Alternatif):
# Almak için: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 4. Yerel Ollama Yapılandırması (Gizlilik / Offline Kullanım):
# USE_OLLAMA=true
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# Varsayılan Sağlayıcı (gemini, openai, anthropic veya ollama):
DEFAULT_AI_PROVIDER=gemini
